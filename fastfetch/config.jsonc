{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 5,
            "left": 3
        },
        "color": {
            "1": "#5e81ac",
            "2": "#d8dee9",
            "3": "#5e81ac",
            "4": "#d8dee9",
            "5": "#5e81ac",
            "6": "#d8dee9",
            "7": "#5e81ac",
            "8": "#d8dee9"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;216;222;233m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "#a3be8c"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "#a3be8c",
            "format": "{name} ({cores-logical}) @ {freq-max} - {temperature}",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "#a3be8c",
            "format": "{name} [{type}] - {temperature}",
            "temp": true
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "#a3be8c"
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "#a3be8c"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;216;222;233m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;216;222;233m┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "#ebcb8b"
        },
        "break",
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "#81a1c1"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "#81a1c1"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "#81a1c1"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "#81a1c1"
        },
        {
            "type": "terminal",
            "key": "│ ├󰆍 ",
            "keyColor": "#81a1c1"
        },
        {
            "type": "icons",
            "key": "└ └ ",
            "keyColor": "#81a1c1"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;216;222;233m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "media",
            "key": "  Audio",
            "keyColor": "#bf616a"
        },
        {
            "type": "player",
            "key": "└ └ ",
            "keyColor": "#bf616a"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;216;222;233m┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "#b48ead",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "#b48ead"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "#b48ead"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;216;222;233m└─────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
